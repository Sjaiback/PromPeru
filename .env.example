# PostgreSQL / Supabase connection (never commit the real .env file)
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.project-reference
DB_PASSWORD=replace-with-your-password
DB_SSLMODE=require
# Supabase transaction pooler works best with non-persistent Django connections.
DB_CONN_MAX_AGE=0
