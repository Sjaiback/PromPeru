# PostgreSQL / Supabase connection (never commit the real .env file)
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.project-reference
DB_PASSWORD=replace-with-your-password
DB_SSLMODE=require
# Session pooler for a persistent Django application.
DB_CONN_MAX_AGE=60

# Password reset email delivery (configure these in Render)
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@your-domain.com
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=no-reply@your-domain.com
